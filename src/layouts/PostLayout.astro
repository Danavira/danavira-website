---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Diagram from '../components/Diagram.astro';
import { localizedPath, t, type Alternates, type Locale } from '../i18n';
import { formatDate, tagSlug } from '../lib/content';
import BaseLayout from './BaseLayout.astro';
import '../styles/prose.css';

interface Props {
  post: CollectionEntry<'writing'>;
  locale: Locale;
  alternates: Alternates;
}

const { post, locale, alternates } = Astro.props;
const { title, description, pubDate, updatedDate, draft, tags, cover } = post.data;
const dict = t(locale);
const { Content } = await render(post);
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  alternates={alternates}
  ogType="article"
  noindex={draft}
>
  <article class="container">
    <header class="intro">
      <h1>{title}</h1>
      <p class="muted meta">
        {draft && <strong class="draft">{dict.post.draft}</strong>}
        {dict.post.published}{' '}
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, locale)}</time>
        {updatedDate && (
          <>
            {' · '}
            {dict.post.updated}{' '}
            <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, locale)}</time>
          </>
        )}
      </p>
      {tags.length > 0 && (
        <ul class="tag-list" aria-label={dict.post.tags}>
          {tags.map((tag) => (
            <li>
              <a href={localizedPath(locale, `writing/tags/${tagSlug(tag)}`)}>{tag}</a>
            </li>
          ))}
        </ul>
      )}
      {cover && <Image class="cover" src={cover.src} alt={cover.alt} width={1200} />}
    </header>
    <div class="prose">
      <Content components={{ Diagram }} />
    </div>
  </article>
</BaseLayout>

<style>
  .intro {
    margin-bottom: var(--space-8);
  }

  .meta {
    font-size: 0.95rem;
  }

  .draft {
    color: var(--focus);
    margin-right: var(--space-2);
  }

  .tag-list a {
    color: inherit;
    text-decoration: none;
  }

  .tag-list a:hover {
    text-decoration: underline;
  }

  .cover {
    display: block;
    width: 100%;
    height: auto;
    margin-top: var(--space-6);
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
</style>
