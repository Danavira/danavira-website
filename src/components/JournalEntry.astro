---
// One journal entry: date and place, title, text, photos. The feed at
// /journal/ links each title to the entry's own page; that page shows it as h1.
import { Image, getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { journalSlug } from '../lib/content';

interface Props {
  entry: CollectionEntry<'journal'>;
  /** true on the entry's own page: the title is the h1 and is not a link. */
  standalone?: boolean;
}

const { entry, standalone = false } = Astro.props;
const { title, date, location, photos } = entry.data;
const { Content } = await render(entry);
const href = `/journal/${journalSlug(entry)}/`;
const Heading = standalone ? 'h1' : 'h2';
const when = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Tokyo',
});

// Each photo links to a large version for a closer look; the grid itself uses
// responsive sizes. Single photos keep their shape, grids crop to 4:3.
const layout = photos.length === 1 ? 'one' : photos.length === 2 ? 'two' : 'many';
const large = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: Math.min(p.src.width, 2048) })),
);
---

<article class="entry">
  <p class="meta">
    <time datetime={date.toISOString()}>{when}</time>
    {location && <span>{location}</span>}
  </p>
  <Heading class="title">{standalone ? title : <a href={href}>{title}</a>}</Heading>

  <div class="prose body">
    <Content />
  </div>

  {photos.length > 0 && (
    <div class:list={['photos', layout]}>
      {photos.map((p, i) => (
        <figure>
          <a href={large[i]?.src}>
            <Image
              src={p.src}
              alt={p.alt}
              widths={[480, 800, 1200, 1600]}
              sizes={
                layout === 'one' || (layout === 'many' && i === 0)
                  ? '(min-width: 72rem) 68rem, 100vw'
                  : '(min-width: 72rem) 34rem, 50vw'
              }
            />
          </a>
          {p.caption && <figcaption>{p.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )}
</article>

<style>
  .entry {
    padding-block: var(--space-12);
    border-top: 1px solid var(--border);
  }

  .entry:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    margin: 0 0 var(--space-2);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .meta span::before {
    content: '/';
    margin-right: var(--space-3);
    color: var(--border-strong);
  }

  .title {
    margin: 0 0 var(--space-6);
    font-size: clamp(1.9rem, 1.5rem + 1.5vw, 2.6rem);
  }

  .title a {
    color: var(--text);
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--link-underline);
  }

  .body {
    max-width: var(--measure);
  }

  .body:empty {
    display: none;
  }

  .photos {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-8);
  }

  .photos.two {
    grid-template-columns: 1fr 1fr;
  }

  @media (min-width: 40rem) {
    .photos.many {
      grid-template-columns: repeat(3, 1fr);
    }

    .photos.many figure:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
  }

  figure {
    margin: 0;
  }

  figure a {
    display: block;
    height: 100%;
  }

  .photos img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .photos.two img,
  .photos.many img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  /* The lead photo of a larger set fills the two rows it spans. */
  @media (min-width: 40rem) {
    .photos.many figure:first-child img {
      height: 100%;
      aspect-ratio: auto;
    }
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
</style>
