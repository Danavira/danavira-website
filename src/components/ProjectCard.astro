---
import type { CollectionEntry } from 'astro:content';
import { t, type Locale } from '../i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  href: string;
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
  featured?: boolean;
}

const { project, href, locale, headingLevel: Heading = 'h3', featured = false } = Astro.props;
const { title, description, stack } = project.data;
---

<article class:list={['card', { featured }]}>
  <Heading class="title">
    <a href={href}>{title}</a>
  </Heading>
  <p>{description}</p>
  <ul class="tag-list" aria-label={t(locale).project.stack}>
    {stack.map((s) => (
      <li>{s}</li>
    ))}
  </ul>
  <span class="cta arrow-link" aria-hidden="true">
    {t(locale).project.readCaseStudy}
  </span>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
    transition: border-color 0.25s var(--ease);
  }

  .card:hover {
    border-top-color: var(--text);
  }

  .card.featured {
    padding: var(--space-8);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .card.featured:hover {
    border-color: var(--border-strong);
  }

  .title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  .featured .title {
    font-size: clamp(1.9rem, 1.6rem + 1vw, 2.4rem);
  }

  .title a {
    color: var(--text);
    text-decoration: none;
  }

  /* The heading link covers the whole card so it is one tab stop and one
     accessible name, but the full card is clickable. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  p {
    color: var(--text-muted);
    max-width: var(--measure);
  }

  .card:focus-within {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .title a:focus-visible {
    outline: none;
  }

  .tag-list {
    margin-bottom: 0;
  }

  .cta {
    margin-top: auto;
    padding-top: var(--space-6);
    color: var(--text);
  }

  .card:hover .cta::after {
    transform: translateX(3px);
  }
</style>
