---
import { t, type Alternates, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  alternates: Alternates;
}

const { locale, alternates } = Astro.props;
const other: Locale = locale === 'en' ? 'ja' : 'en';
const href = alternates[other];
const { label, hreflang } = t(locale).langSwitch;
---

{href && (
  <a class="lang" href={href} hreflang={hreflang} lang={hreflang}>
    {label}
  </a>
)}

<style>
  .lang {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.2rem 0.55rem;
    text-decoration: none;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .lang:hover {
    color: var(--text);
    border-color: var(--text);
  }
</style>
