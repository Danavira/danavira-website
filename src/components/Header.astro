---
import { localizedPath, t, type Alternates, type Locale } from '../i18n';
import { site } from '../site.config';
import LangSwitch from './LangSwitch.astro';

interface Props {
  locale: Locale;
  alternates: Alternates;
  /** Where each nav item points. Falls back to English when no translation exists. */
  nav: {
    key: 'projects' | 'homelab' | 'writing' | 'cv' | 'certifications' | 'contact';
    href: string;
  }[];
}

const { locale, alternates, nav } = Astro.props;
const dict = t(locale);
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container wide bar">
    <a class="name" href={localizedPath(locale)}>
      {site.name}
    </a>
    <nav aria-label={dict.nav.label}>
      <ul>
        {nav.map(({ key, href }) => (
          <li>
            <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
              {dict.nav[key]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <LangSwitch locale={locale} alternates={alternates} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-8);
    padding-block: var(--space-4);
  }

  .name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    margin-right: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    position: relative;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.2rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* On phones the nav wraps under the name, so a sticky bar would eat a
     sixth of the screen. */
  @media (max-width: 40rem) {
    .site-header {
      position: static;
    }

    .bar {
      gap: var(--space-3) var(--space-4);
    }

    nav {
      order: 3;
      width: 100%;
    }

    ul {
      gap: var(--space-1) var(--space-4);
    }
  }
</style>
