---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import ClusterMap from '../../components/ClusterMap.astro';
import PostList from '../../components/PostList.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { alternatesFor, localeFromParam, localeParam, localizedPath, t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getCertifications,
  getExperience,
  getJournal,
  getOrdered,
  getPage,
  getProjects,
  getPublishedPosts,
  journalExcerpt,
  journalSlug,
  pageLocales,
  slugOf,
} from '../../lib/content';
import { site } from '../../site.config';

export async function getStaticPaths() {
  return (await pageLocales('home')).map((l) => ({ params: { locale: localeParam(l) } }));
}

const locale = localeFromParam(Astro.params.locale);
const dict = t(locale);
const page = await getPage(locale, 'home');
if (!page) throw new Error(`pages/${locale}/home.mdx not found`);
const { Content } = await render(page);

const projects = await getProjects(locale);
const featured = projects.find((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured).slice(0, 3);
const posts = (await getPublishedPosts(locale)).slice(0, 3);
const cvHref = localizedPath((await pageLocales('cv')).includes(locale) ? locale : 'en', 'cv');
const certs = await getCertifications();
const featuredCerts = certs.filter((c) => c.data.featured);

// About: paragraphs from the CMS, facts from the same data as the resume so
// the two never disagree.
const aboutParagraphs = (page.data.about ?? '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
const [latest] = await getJournal();
const latestWhen = latest?.data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Tokyo',
});
const currentRole = (await getExperience('work')).find((e) => !e.data.end);
const spoken = (await getOrdered('skills')).find((s) => s.id === 'languages');
const facts = [
  currentRole && {
    label: dict.home.facts.now,
    value: `${currentRole.data.role}, ${currentRole.data.org}`,
  },
  { label: dict.home.facts.based, value: site.location },
  {
    label: dict.home.facts.studied,
    value: `${site.education.degree}, ${site.education.school}`,
  },
  spoken && { label: dict.home.facts.languages, value: spoken.data.items.join(', ') },
].filter((f): f is { label: string; value: string } => Boolean(f));

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  url: site.url,
  homeLocation: { '@type': 'Place', name: site.location },
  alumniOf: { '@type': 'CollegeOrUniversity', name: site.education.school },
  hasCredential: certs.map(({ data }) => ({
    '@type': 'EducationalOccupationalCredential',
    name: data.name,
    recognizedBy: { '@type': 'Organization', name: data.issuer },
  })),
  sameAs: [site.github, site.linkedin],
};
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  alternates={alternatesFor(await pageLocales('home'))}
  isHome
  ogType="profile"
  jsonLd={person}
>
  <div class="container wide">
    <section class="hero" aria-labelledby="name">
      {page.data.identity && <p class="eyebrow">{page.data.identity}</p>}
      <h1 id="name">{page.data.title}</h1>
      <div class="bio">
        <Content />
      </div>
      <ul class="cta">
        <li>
          <a class="button" href={cvHref}>
            {dict.links.cv}
          </a>
        </li>
        <li>
          <a class="button ghost" href={`mailto:${site.email}`}>
            {dict.links.email}
          </a>
        </li>
        <li>
          <a class="plain" href={site.github}>
            {dict.links.github}
          </a>
        </li>
        <li>
          <a class="plain" href={site.linkedin}>
            {dict.links.linkedin}
          </a>
        </li>
      </ul>
    </section>

    <section class="credentials" aria-labelledby="credentials">
      <h2 id="credentials" class="eyebrow">
        {dict.home.credentials}
      </h2>
      <ul>
        {featuredCerts.map(({ id, data }) => (
          <li>
            <a href={`${localizedPath('en', 'certifications')}#${id}`}>
              {data.name.replace(/ \(.*\)$/, '')}
            </a>
          </li>
        ))}
        <li>
          {site.education.degree}, {site.education.school}
        </li>
      </ul>
      <a class="arrow-link" href={localizedPath('en', 'certifications')}>
        {dict.home.allCertifications}
      </a>
    </section>

    {aboutParagraphs.length > 0 && (
      <section class="about" aria-labelledby="about">
        <h2 id="about" class="eyebrow">
          {dict.home.about}
        </h2>
        <div class="about-text">
          {aboutParagraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
        <div class="about-facts">
          <dl>
            {facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
          <a class="arrow-link" href={cvHref}>
            {dict.home.fullResume}
          </a>
        </div>
      </section>
    )}

    {latest && (
      <section aria-labelledby="lately">
        <div class="section-head">
          <h2 id="lately">{dict.journal.lately}</h2>
          <a class="arrow-link" href="/journal/">
            {dict.journal.all}
          </a>
        </div>
        <article class:list={['lately', { 'has-photo': latest.data.photos.length > 0 }]}>
          {latest.data.photos[0] && (
            <a class="lately-photo" href={`/journal/${journalSlug(latest)}/`} tabindex="-1">
              <Image
                src={latest.data.photos[0].src}
                alt={latest.data.photos[0].alt}
                widths={[480, 800, 1200]}
                sizes="(min-width: 52rem) 40rem, 100vw"
              />
            </a>
          )}
          <div>
            <p class="eyebrow">
              <time datetime={latest.data.date.toISOString()}>{latestWhen}</time>
              {latest.data.location && ` / ${latest.data.location}`}
            </p>
            <h3>
              <a href={`/journal/${journalSlug(latest)}/`}>{latest.data.title}</a>
            </h3>
            <p class="muted">{journalExcerpt(latest, 220)}</p>
          </div>
        </article>
      </section>
    )}

    {featured && (
      <section aria-labelledby="featured">
        <div class="section-head">
          <h2 id="featured">{dict.home.featured}</h2>
        </div>
        <ProjectCard
          project={featured}
          href={localizedPath(locale, 'homelab')}
          locale={locale}
          featured
        />
        <ClusterMap variant="summary" />
      </section>
    )}

    {others.length > 0 && (
      <section aria-labelledby="projects">
        <div class="section-head">
          <h2 id="projects">{dict.home.projects}</h2>
          <a class="arrow-link" href={localizedPath(locale, 'projects')}>
            {dict.home.allProjects}
          </a>
        </div>
        <div class="grid">
          {others.map((p) => (
            <ProjectCard
              project={p}
              href={localizedPath(locale, `projects/${slugOf(p)}`)}
              locale={locale}
            />
          ))}
        </div>
      </section>
    )}

    {posts.length > 0 && (
      <section aria-labelledby="writing">
        <div class="section-head">
          <h2 id="writing">{dict.home.writing}</h2>
          <a class="arrow-link" href={localizedPath(locale, 'writing')}>
            {dict.home.allWriting}
          </a>
        </div>
        <PostList posts={posts} locale={locale} headingLevel="h3" />
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .hero {
    max-width: 46rem;
    padding-block: 0 var(--space-12);
  }

  @media (min-width: 40rem) {
    .hero {
      padding-top: var(--space-8);
    }
  }

  .hero h1 {
    font-size: clamp(3.25rem, 2rem + 6vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: var(--space-4) 0 var(--space-8);
  }

  .bio {
    font-size: 1.125rem;
    line-height: 1.75;
    color: #333;
    max-width: var(--measure);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-3);
    padding: 0;
    margin: var(--space-8) 0 0;
    list-style: none;
  }

  .cta .plain {
    padding: 0.65rem 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .credentials {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-block: 1px solid var(--border);
  }

  @media (min-width: 52rem) {
    .credentials {
      grid-template-columns: 10rem 1fr auto;
      align-items: baseline;
      gap: var(--space-8);
    }
  }

  .credentials h2 {
    margin: 0;
    line-height: 1.7;
  }

  .credentials ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.925rem;
  }

  .credentials li:not(:last-child)::after {
    content: '/';
    margin-inline: var(--space-3);
    color: var(--border-strong);
  }

  .credentials ul a {
    color: var(--text);
    text-decoration: none;
  }

  .credentials ul a:hover {
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
  }

  .credentials .arrow-link {
    white-space: nowrap;
  }

  .about {
    display: grid;
    gap: var(--space-6) var(--space-8);
    padding-block: var(--space-16) 0;
  }

  @media (min-width: 52rem) {
    .about {
      grid-template-columns: 10rem minmax(0, 1fr) 18rem;
      gap: var(--space-8) var(--space-12);
    }
  }

  .about h2 {
    margin: 0;
    line-height: 2.2;
  }

  .about-text {
    max-width: var(--measure);
  }

  .about-text p {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.55rem);
    line-height: 1.45;
    letter-spacing: -0.005em;
    margin-bottom: var(--space-6);
  }

  .about-text p + p {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted);
  }

  .about-facts dl {
    margin: 0 0 var(--space-6);
    border-top: 1px solid var(--border);
  }

  .about-facts dl div {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .about-facts dt {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .about-facts dd {
    margin: var(--space-1) 0 0;
    font-size: 0.925rem;
  }

  .lately {
    display: grid;
    gap: var(--space-6) var(--space-12);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .lately.has-photo {
      grid-template-columns: 3fr 2fr;
    }
  }

  .lately-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .lately h3 {
    margin: var(--space-2) 0 var(--space-3);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1.2vw, 2.4rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .lately h3 a {
    color: var(--text);
    text-decoration: none;
  }

  .lately h3 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--link-underline);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-24) 0 var(--space-8);
  }

  .section-head h2 {
    margin: 0;
  }

  .grid {
    display: grid;
    gap: var(--space-12) var(--space-8);
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
  }
</style>
