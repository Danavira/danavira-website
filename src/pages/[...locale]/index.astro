---
import { render } from 'astro:content';
import PostList from '../../components/PostList.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { alternatesFor, localeFromParam, localeParam, localizedPath, t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getCertifications,
  getPage,
  getProjects,
  getPublishedPosts,
  pageLocales,
  slugOf,
} from '../../lib/content';
import { site } from '../../site.config';

export async function getStaticPaths() {
  return (await pageLocales('home')).map((l) => ({ params: { locale: localeParam(l) } }));
}

const locale = localeFromParam(Astro.params.locale);
const dict = t(locale);
const page = await getPage(locale, 'home');
if (!page) throw new Error(`pages/${locale}/home.mdx not found`);
const { Content } = await render(page);

const projects = await getProjects(locale);
const featured = projects.find((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured).slice(0, 3);
const posts = (await getPublishedPosts(locale)).slice(0, 3);
const cvHref = localizedPath((await pageLocales('cv')).includes(locale) ? locale : 'en', 'cv');
const certs = await getCertifications();
const featuredCerts = certs.filter((c) => c.data.featured);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.jobTitle,
  url: site.url,
  homeLocation: { '@type': 'Place', name: site.location },
  alumniOf: { '@type': 'CollegeOrUniversity', name: site.education.school },
  hasCredential: certs.map(({ data }) => ({
    '@type': 'EducationalOccupationalCredential',
    name: data.name,
    recognizedBy: { '@type': 'Organization', name: data.issuer },
  })),
  sameAs: [site.github, site.linkedin],
};
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  locale={locale}
  alternates={alternatesFor(await pageLocales('home'))}
  isHome
  ogType="profile"
  jsonLd={person}
>
  <div class="container wide">
    <section class="hero" aria-labelledby="name">
      {page.data.identity && <p class="eyebrow">{page.data.identity}</p>}
      <h1 id="name">{page.data.title}</h1>
      <div class="bio">
        <Content />
      </div>
      <ul class="cta">
        <li>
          <a class="button" href={cvHref}>
            {dict.links.cv}
          </a>
        </li>
        <li>
          <a class="button ghost" href={`mailto:${site.email}`}>
            {dict.links.email}
          </a>
        </li>
        <li>
          <a class="plain" href={site.github}>
            {dict.links.github}
          </a>
        </li>
        <li>
          <a class="plain" href={site.linkedin}>
            {dict.links.linkedin}
          </a>
        </li>
      </ul>
    </section>

    <section class="credentials" aria-labelledby="credentials">
      <h2 id="credentials" class="eyebrow">
        {dict.home.credentials}
      </h2>
      <ul>
        {featuredCerts.map(({ id, data }) => (
          <li>
            <a href={`${localizedPath('en', 'certifications')}#${id}`}>
              {data.name.replace(/ \(.*\)$/, '')}
            </a>
          </li>
        ))}
        <li>
          {site.education.degree}, {site.education.school}
        </li>
      </ul>
      <a class="arrow-link" href={localizedPath('en', 'certifications')}>
        {dict.home.allCertifications}
      </a>
    </section>

    {featured && (
      <section aria-labelledby="featured">
        <div class="section-head">
          <h2 id="featured">{dict.home.featured}</h2>
        </div>
        <ProjectCard
          project={featured}
          href={localizedPath(locale, 'homelab')}
          locale={locale}
          featured
        />
      </section>
    )}

    {others.length > 0 && (
      <section aria-labelledby="projects">
        <div class="section-head">
          <h2 id="projects">{dict.home.projects}</h2>
          <a class="arrow-link" href={localizedPath(locale, 'projects')}>
            {dict.home.allProjects}
          </a>
        </div>
        <div class="grid">
          {others.map((p) => (
            <ProjectCard
              project={p}
              href={localizedPath(locale, `projects/${slugOf(p)}`)}
              locale={locale}
            />
          ))}
        </div>
      </section>
    )}

    {posts.length > 0 && (
      <section aria-labelledby="writing">
        <div class="section-head">
          <h2 id="writing">{dict.home.writing}</h2>
          <a class="arrow-link" href={localizedPath(locale, 'writing')}>
            {dict.home.allWriting}
          </a>
        </div>
        <PostList posts={posts} locale={locale} headingLevel="h3" />
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .hero {
    max-width: 46rem;
    padding-block: 0 var(--space-12);
  }

  @media (min-width: 40rem) {
    .hero {
      padding-top: var(--space-8);
    }
  }

  .hero h1 {
    font-size: clamp(3.25rem, 2rem + 6vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: var(--space-4) 0 var(--space-8);
  }

  .bio {
    font-size: 1.125rem;
    line-height: 1.75;
    color: #333;
    max-width: var(--measure);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-3);
    padding: 0;
    margin: var(--space-8) 0 0;
    list-style: none;
  }

  .cta .plain {
    padding: 0.65rem 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .credentials {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-block: 1px solid var(--border);
  }

  @media (min-width: 52rem) {
    .credentials {
      grid-template-columns: 10rem 1fr auto;
      align-items: baseline;
      gap: var(--space-8);
    }
  }

  .credentials h2 {
    margin: 0;
    line-height: 1.7;
  }

  .credentials ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.925rem;
  }

  .credentials li:not(:last-child)::after {
    content: '/';
    margin-inline: var(--space-3);
    color: var(--border-strong);
  }

  .credentials ul a {
    color: var(--text);
    text-decoration: none;
  }

  .credentials ul a:hover {
    text-decoration: underline;
    text-decoration-color: var(--link-underline);
  }

  .credentials .arrow-link {
    white-space: nowrap;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-24) 0 var(--space-8);
  }

  .section-head h2 {
    margin: 0;
  }

  .grid {
    display: grid;
    gap: var(--space-12) var(--space-8);
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
  }
</style>
