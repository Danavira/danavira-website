---
import { alternatesFor, localizedPath, t } from '../i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';

// No form: the site ships no JavaScript and its CSP sets form-action 'none',
// so a mailto link is the contact method. English only, like /certifications/.
const locale = 'en';
const dict = t(locale);
const github = site.github.replace(/^https:\/\//, '');
const linkedin = site.linkedin.replace(/^https:\/\/(www\.)?/, '');
---

<BaseLayout
  title={dict.contact.title}
  description={dict.contact.description}
  locale={locale}
  alternates={alternatesFor(['en'], 'contact')}
>
  <div class="container">
    <h1>{dict.contact.title}</h1>
    <p>{dict.contact.lead}</p>
    <p class="email">
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <p class="muted">{site.availability}</p>

    <h2>{dict.contact.elsewhere}</h2>
    <dl>
      <dt>{dict.links.linkedin}</dt>
      <dd>
        <a href={site.linkedin}>{linkedin}</a>
      </dd>
      <dt>{dict.links.github}</dt>
      <dd>
        <a href={site.github}>{github}</a>
      </dd>
      <dt>{dict.nav.cv}</dt>
      <dd>
        <a href={localizedPath(locale, 'cv')}>{`danavira.com/cv/`}</a>
      </dd>
    </dl>
  </div>
</BaseLayout>

<style>
  .email {
    font-size: 1.35rem;
    font-weight: 600;
    margin: var(--space-6) 0;
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-6);
  }

  dt {
    color: var(--text-muted);
  }

  dd {
    margin: 0;
  }
</style>
